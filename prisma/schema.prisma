// Prisma schema — GymLog
// Le générateur "prisma-client" (Prisma 7) produit un client ESM dans src/generated/prisma.
// L'URL de connexion vit dans prisma.config.ts (chargée depuis DATABASE_URL), jamais ici.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  exercises        Exercise[]
  workoutTemplates WorkoutTemplate[]
  workoutSessions  WorkoutSession[]
}

// Modèles requis par Auth.js (Prisma adapter). @auth/prisma-adapter appelle
// prisma.account / prisma.session / prisma.verificationToken en dur : les noms de modèles
// Prisma doivent donc être exactement Account / Session / VerificationToken, sans quoi
// l'adaptateur plante silencieusement (prisma.account === undefined).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Session de connexion (Auth.js) — sans lien avec WorkoutSession, qui est une séance d'entraînement.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Exercise {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  muscle       String[]
  // Facultatif : nombre de séries recopié dans une séance au moment où l'exercice y est ajouté
  // (voir WorkoutExercise.targetSets). null = aucune série proposée d'office.
  targetSets   Int?
  description  String?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workoutExercises WorkoutExercise[]
  workoutSets      WorkoutSet[]

  @@index([userId])
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  order       Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
  schedules WorkoutSchedule[]

  @@index([userId])
}

model WorkoutExercise {
  id                String          @id @default(cuid())
  workoutTemplateId String
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise        @relation(fields: [exerciseId], references: [id])
  order             Int
  // Copie de Exercise.targetSets figée à l'ajout dans la séance : modifier l'exercice ensuite ne
  // change que les prochains ajouts, jamais les séances qui le contiennent déjà.
  targetSets        Int             @default(0)

  @@index([workoutTemplateId])
  @@index([exerciseId])
}

model WorkoutSchedule {
  id                String          @id @default(cuid())
  workoutTemplateId String
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  dayOfWeek         Int // 0 = dimanche ... 6 = samedi

  @@index([workoutTemplateId])
}

model WorkoutSession {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  workoutTemplateId String?
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id])
  name              String
  startedAt         DateTime         @default(now())
  // Dernière modification de la séance (série ajoutée/loguée/modifiée/supprimée) — voir
  // session-mutations.ts, qui la met à jour à chaque mutation. Sert de référence à la fermeture
  // automatique par inactivité (voir SESSION_AUTO_CLOSE_MS dans session-status.ts) : `startedAt`
  // ne bouge jamais une fois la séance créée, donc une longue séance activement suivie serait sinon
  // clôturée en plein milieu.
  lastActivityAt    DateTime         @default(now())
  completedAt       DateTime?
  note              String?

  sets WorkoutSet[]

  @@index([userId])
  @@index([workoutTemplateId])
}

model WorkoutSet {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  exerciseOrder    Int
  // Variante (mode Avancé) : série faite sur `exerciseId` à la place de cet exercice du programme
  // (machine prise…). L'historique de l'exercice prévu ne voit donc jamais ces séries ; la séance les
  // range quand même à sa place (voir sessions/[id]/page.tsx). null = l'exercice prévu lui-même.
  substituteForId  String?
  setNumber        Int
  actualWeight     Float?
  actualReps       Float?
  note             String?
  completed        Boolean        @default(false)

  @@index([workoutSessionId])
  @@index([exerciseId])
}
